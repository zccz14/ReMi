# ReMi Server Configuration

# Server
PORT=3000
DATA_DIR=./data

# CORS (frontend origin, comma-separated)
CORS_ORIGIN=http://localhost:5173

# LLM (all three required for AI chat)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o

# Embedding (required for anchor recall)
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Auth (timestamp window in ms, default 30s, increase for dev/debugging)
# AUTH_TIMESTAMP_WINDOW_MS=30000

# Logging (trace, debug, info, warn, error, fatal; default: info)
# LOG_LEVEL=info

# Public local sharing (Phase 1 proxy mode)
# WEB_MODE=proxy
# VITE_DEV_ORIGIN=http://localhost:5173
